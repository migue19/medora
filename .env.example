# Configuración para Docker Compose (copiar a .env y editar)
POSTGRES_DB=medora
POSTGRES_USER=medora
POSTGRES_PASSWORD=cambia-esta-contrasena
# Debe coincidir con POSTGRES_*; el host es "db". Codificar caracteres especiales en la URL.
DATABASE_URL=postgresql://medora:cambia-esta-contrasena@db:5432/medora

# 32+ caracteres aleatorios: openssl rand -base64 48
JWT_SECRET=
APP_ENV=development
WEB_ORIGIN=http://localhost:6011
COOKIE_SECURE=false

# Correo (obligatorio con APP_ENV=production). Sin SMTP_HOST los correos se escriben en la bitácora.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Medora <no-reply@tu-dominio.com>

# WhatsApp Business Cloud API (opcional; sin token, recordatorios sólo por correo)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=recordatorio_cita
WHATSAPP_TEMPLATE_LANG=es_MX
WHATSAPP_REVIEW_TEMPLATE=invitacion_opinion
WHATSAPP_DEFAULT_COUNTRY=52

# Clínica inicial y propietario (seed idempotente)
SEED_CLINIC_SLUG=mi-clinica
SEED_CLINIC_NAME=Mi Clínica
SEED_OWNER_EMAIL=
SEED_OWNER_NAME=
# 12+ caracteres, único
SEED_OWNER_PASSWORD=
# true crea un médico, servicio y horario de demostración si la clínica no tiene médicos
SEED_DEMO_DATA=false

# Pagos en línea (Stripe, cuenta de Medora). Vacío = pagos desactivados. Llaves sk_test_ fuera de producción.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Videoconsultas (Daily). Vacío = telemedicina desactivada.
DAILY_API_KEY=

# Llave AES-256 de los adjuntos del expediente: openssl rand -base64 32. Guárdala aparte: sin ella los adjuntos no se pueden leer.
RECORDS_ENCRYPTION_KEY=

# Administración de Medora (verifican cédulas): correos separados por coma.
SUPERADMIN_EMAILS=
# Facturación CFDI 4.0 con Facturama (API de un solo emisor). Vacío = sin timbrado.
FACTURAMA_USER=
FACTURAMA_PASSWORD=
FACTURAMA_SANDBOX=true
INVOICE_EXPEDITION_ZIP=
INVOICE_SERIES=MED
# Retención de ISR 1.25 % (RESICO a personas morales). Confirmar con el contador.
INVOICE_RESICO_RETENTION=false

# Calendarios de los médicos (OAuth). Redirect: https://<sitio>/api/integrations/google|microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Notificaciones push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@nut.com.mx
