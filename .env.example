# Configuración para Docker Compose (copiar a .env y editar)
POSTGRES_DB=medora
POSTGRES_USER=medora
POSTGRES_PASSWORD=cambia-esta-contrasena
# Debe coincidir con POSTGRES_*; el host es "db". Codificar caracteres especiales en la URL.
DATABASE_URL=postgresql://medora:cambia-esta-contrasena@db:5432/medora

# 32+ caracteres aleatorios: openssl rand -base64 48
JWT_SECRET=
APP_ENV=development
WEB_ORIGIN=http://localhost:6011
COOKIE_SECURE=false

# Correo (obligatorio con APP_ENV=production). Sin SMTP_HOST los correos se escriben en la bitácora.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Medora <no-reply@tu-dominio.com>

# WhatsApp Business Cloud API (opcional; sin token, recordatorios sólo por correo)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=recordatorio_cita
WHATSAPP_TEMPLATE_LANG=es_MX
WHATSAPP_REVIEW_TEMPLATE=invitacion_opinion
WHATSAPP_DEFAULT_COUNTRY=52

# Clínica inicial y propietario (seed idempotente)
SEED_CLINIC_SLUG=mi-clinica
SEED_CLINIC_NAME=Mi Clínica
SEED_OWNER_EMAIL=
SEED_OWNER_NAME=
# 12+ caracteres, único
SEED_OWNER_PASSWORD=
# true crea un médico, servicio y horario de demostración si la clínica no tiene médicos
SEED_DEMO_DATA=false
