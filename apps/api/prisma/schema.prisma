// Medora · Sprint 11
// Todas las entidades de negocio llevan clinicId y se consultan siempre
// filtradas por la clínica obtenida de la sesión.

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  OWNER
  ADMIN
  RECEPTION
  DOCTOR
}

enum SessionKind {
  STAFF
  PATIENT
}

enum AppointmentStatus {
  // Reservada en línea en una clínica con pago obligatorio: aparta el horario hasta paymentDueAt.
  PENDING_PAYMENT
  BOOKED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE
  STAFF
}

enum ActorKind {
  STAFF
  PATIENT
  // Procesos automáticos (vencimiento de pagos).
  SYSTEM
}

enum AppointmentModality {
  IN_PERSON
  // Videoconsulta: sala de Daily por cita.
  VIDEO
}

enum PaymentMode {
  OFF
  OPTIONAL
  REQUIRED
}

enum PaymentStatus {
  // Sesión de pago abierta.
  OPEN
  // Ficha OXXO o transferencia SPEI emitida, en espera del depósito.
  PROCESSING
  PAID
  EXPIRED
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum AuthTokenKind {
  PATIENT_VERIFY_EMAIL
  PATIENT_RESET_PASSWORD
  STAFF_RESET_PASSWORD
}

enum AppointmentEventType {
  CREATED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
  CONFIRMED
  PAID
  REFUNDED
}

enum PatientAuditAction {
  CREATED
  UPDATED
  LINK_REQUESTED
  LINKED
  MERGED
}

enum WaitlistStatus {
  WAITING
  BOOKED
  REMOVED
}

enum WaitlistOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  RELEASED
}

enum VisitType {
  ANY
  FIRST
  FOLLOW_UP
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum ReviewEventType {
  CREATED
  HIDDEN
  RESTORED
  REPLIED
  REPLY_REMOVED
}

enum OnboardingStatus {
  DRAFT
  SUBMITTED
  IMPORTED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

model Clinic {
  id                      String   @id @default(uuid()) @db.Uuid
  slug                    String   @unique @db.VarChar(60)
  name                    String   @db.VarChar(120)
  timezone                String   @default("America/Mexico_City") @db.VarChar(64)
  phone                   String?  @db.VarChar(30)
  address                 String?  @db.VarChar(240)
  active                  Boolean  @default(true)
  bookingEnabled          Boolean  @default(true)
  minNoticeMinutes        Int      @default(60)
  horizonDays             Int      @default(60)
  patientCancelMinMinutes Int      @default(120)
  remindersEnabled        Boolean  @default(true)
  // Minutos antes de la cita (por defecto 24 h y 2 h).
  reminderOffsets         Int[]    @default([1440, 120])
  whatsappEnabled         Boolean  @default(false)
  // Invitar a opinar a los pacientes después de una cita atendida.
  reviewsEnabled          Boolean  @default(true)
  // Aparecer en el directorio público de Medora (búsqueda entre clínicas).
  directoryEnabled        Boolean  @default(false)
  // Pagos en línea (Stripe, cuenta de Medora).
  paymentMode             PaymentMode @default(OFF)
  // Anticipo: porcentaje del precio de la cita (100 = pago completo).
  depositPercent          Int      @default(100)
  // Cancelar con al menos esta anticipación reembolsa el pago; después (o si no asiste) no hay reembolso.
  refundMinMinutes        Int      @default(1440)
  // Aceptar OXXO y transferencia SPEI (sólo para citas con 3 días o más de anticipación).
  asyncPaymentsEnabled    Boolean  @default(false)
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  memberships    Membership[]
  invitations    StaffInvitation[]
  locations      Location[]
  doctors        Doctor[]
  services       Service[]
  clinicPatients ClinicPatient[]
  appointments   Appointment[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  name         String   @db.VarChar(120)
  passwordHash String   @db.VarChar(255)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  memberships Membership[]
  authTokens  AuthToken[]
}

model Membership {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  clinicId  String    @db.Uuid
  role      StaffRole
  active    Boolean   @default(true)
  // Acceso al expediente clínico de todos los pacientes (dirección médica). Los médicos ven a sus pacientes sin esto.
  clinicalAccess Boolean @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id])
  clinic   Clinic           @relation(fields: [clinicId], references: [id])
  doctor   Doctor?          @relation("DoctorMembership")
  sessions RefreshSession[]

  @@unique([userId, clinicId])
  @@unique([id, clinicId])
  @@index([clinicId])
}

model PatientAccount {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  name         String   @db.VarChar(120)
  phone           String    @db.VarChar(30)
  passwordHash    String    @db.VarChar(255)
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  // Consentimiento expreso para recordatorios por WhatsApp.
  whatsappConsentAt DateTime? @db.Timestamptz(3)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  clinicPatients ClinicPatient[]
  sessions       RefreshSession[]
  authTokens     AuthToken[]
}

model RefreshSession {
  id               String      @id @default(uuid()) @db.Uuid
  kind             SessionKind
  familyId         String      @db.Uuid
  tokenHash        String      @unique @db.Char(64)
  membershipId     String?     @db.Uuid
  patientAccountId String?     @db.Uuid
  expiresAt        DateTime    @db.Timestamptz(3)
  usedAt           DateTime?   @db.Timestamptz(3)
  revokedAt        DateTime?   @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)

  membership     Membership?     @relation(fields: [membershipId], references: [id])
  patientAccount PatientAccount? @relation(fields: [patientAccountId], references: [id])

  @@index([familyId])
  @@index([membershipId])
  @@index([patientAccountId])
}

// Ficha del paciente dentro de una clínica. Puede venir de una cuenta en línea
// o ser capturada por recepción (paciente telefónico sin cuenta).
model ClinicPatient {
  id               String   @id @default(uuid()) @db.Uuid
  clinicId         String   @db.Uuid
  patientAccountId String?  @db.Uuid
  name             String   @db.VarChar(120)
  phone            String   @db.VarChar(30)
  email            String?  @db.VarChar(254)
  // Consentimiento registrado por la clínica (pacientes telefónicos).
  whatsappConsentAt DateTime? @db.Timestamptz(3)
  // Etiquetas libres de la clínica (p. ej. «diabetes», «VIP»).
  tags             String[] @default([])
  // Ficha fusionada en otra: queda oculta y sólo se conserva para auditoría.
  mergedIntoId     String?  @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  patientAccount PatientAccount? @relation(fields: [patientAccountId], references: [id])
  appointments   Appointment[]
  notes          PatientNote[]
  audit          PatientAudit[]
  waitlist       WaitlistEntry[]
  clinicalProfile ClinicalProfile?
  allergies       Allergy[]
  clinicalNotes   ClinicalNote[]
  prescriptions   Prescription[]
  clinicalFiles   ClinicalFile[]

  @@unique([clinicId, patientAccountId])
  @@unique([id, clinicId])
  @@index([clinicId, name])
}

model Doctor {
  id           String   @id @default(uuid()) @db.Uuid
  clinicId     String   @db.Uuid
  membershipId String?  @unique @db.Uuid
  displayName  String   @db.VarChar(120)
  // URL pública del médico: /c/<clínica>/<slug>. Estable aunque cambie el nombre.
  slug         String   @db.VarChar(80)
  specialty    String   @db.VarChar(120)
  // Especialidad del catálogo (se deduce del texto de la especialidad al guardar).
  specialtyId  String?  @db.Uuid
  // Texto normalizado (sin acentos, minúsculas) para la búsqueda de texto completo.
  searchText   String   @default("")
  licenseNumber String? @db.VarChar(30)
  bio          String?  @db.VarChar(1000)
  // Perfil profesional (listas cortas de texto).
  education      String[] @default([])
  certifications String[] @default([])
  languages      String[] @default([])
  conditions     String[] @default([])
  insurers       String[] @default([])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  clinic       Clinic           @relation(fields: [clinicId], references: [id])
  membership   Membership?      @relation("DoctorMembership", fields: [membershipId, clinicId], references: [id, clinicId])
  services     DoctorService[]
  scheduleRules ScheduleRule[]
  timeOffs     TimeOff[]
  appointments Appointment[]
  photo        DoctorPhoto?
  specialtyRef Specialty?        @relation(fields: [specialtyId], references: [id])
  conditionRefs DoctorCondition[]

  @@unique([id, clinicId])
  @@unique([membershipId, clinicId])
  @@unique([clinicId, slug])
  @@index([clinicId])
}

model Service {
  id              String   @id @default(uuid()) @db.Uuid
  clinicId        String   @db.Uuid
  name            String   @db.VarChar(120)
  durationMinutes Int
  priceCents      Int
  // Primera vez, subsecuente o cualquiera (se exige en reservas en línea).
  visitType       VisitType @default(ANY)
  // Se atiende por videoconsulta (filtro del directorio; la sala llega en el Sprint 10).
  telemedicine    Boolean   @default(false)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  clinic       Clinic          @relation(fields: [clinicId], references: [id])
  doctors      DoctorService[]
  appointments Appointment[]
  prices       ServicePrice[]

  @@unique([clinicId, name])
  @@unique([id, clinicId])
}

model DoctorService {
  doctorId  String @db.Uuid
  serviceId String @db.Uuid
  clinicId  String @db.Uuid

  doctor  Doctor  @relation(fields: [doctorId, clinicId], references: [id, clinicId])
  service Service @relation(fields: [serviceId, clinicId], references: [id, clinicId])

  @@id([doctorId, serviceId])
}

// Horario semanal en hora local de la clínica. weekday: 1 = lunes … 7 = domingo (ISO).
model ScheduleRule {
  id          String @id @default(uuid()) @db.Uuid
  doctorId    String @db.Uuid
  clinicId    String @db.Uuid
  weekday     Int
  startMinute Int
  endMinute   Int
  locationId  String @db.Uuid
  roomId      String? @db.Uuid

  doctor   Doctor   @relation(fields: [doctorId, clinicId], references: [id, clinicId])
  location Location @relation(fields: [locationId], references: [id])
  room     Room?    @relation(fields: [roomId], references: [id])

  @@index([doctorId])
  @@index([roomId])
}

model TimeOff {
  id          String   @id @default(uuid()) @db.Uuid
  doctorId    String   @db.Uuid
  clinicId    String   @db.Uuid
  startsAt    DateTime @db.Timestamptz(3)
  endsAt      DateTime @db.Timestamptz(3)
  reason      String   @db.VarChar(200)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  doctor Doctor @relation(fields: [doctorId, clinicId], references: [id, clinicId])

  @@index([doctorId, startsAt])
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  clinicId        String            @db.Uuid
  doctorId        String            @db.Uuid
  serviceId       String            @db.Uuid
  clinicPatientId String            @db.Uuid
  startsAt        DateTime          @db.Timestamptz(3)
  endsAt          DateTime          @db.Timestamptz(3)
  status          AppointmentStatus @default(BOOKED)
  source          AppointmentSource
  serviceName     String            @db.VarChar(120)
  durationMinutes Int
  priceCents      Int
  patientNotes    String?           @db.VarChar(500)
  requestKey      String            @unique @db.VarChar(120)
  requestHash     String            @db.Char(64)
  cancelReason    String?           @db.VarChar(200)
  // El paciente confirmó su asistencia (se reinicia al reprogramar).
  confirmedAt     DateTime?         @db.Timestamptz(3)
  // Cita subsecuente: la cita atendida de la que se agendó.
  followUpOfId    String?           @db.Uuid
  // Canal por el que llegó una reserva en línea: web, widget, google o instagram.
  channel         String?           @db.VarChar(20)
  // Pago obligatorio: si no se paga antes, la cita se cancela y el horario se libera.
  paymentDueAt    DateTime?         @db.Timestamptz(3)
  modality        AppointmentModality @default(IN_PERSON)
  // Videoconsulta: consentimiento informado del paciente (versión del texto aceptado) y presencia en la sala.
  videoConsentAt      DateTime?     @db.Timestamptz(3)
  videoConsentVersion String?       @db.VarChar(20)
  patientJoinedAt     DateTime?     @db.Timestamptz(3)
  patientSeenAt       DateTime?     @db.Timestamptz(3)
  doctorJoinedAt      DateTime?     @db.Timestamptz(3)
  // Sede y consultorio del bloque del horario en que cae la cita.
  locationId      String            @db.Uuid
  roomId          String?           @db.Uuid
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  clinic        Clinic             @relation(fields: [clinicId], references: [id])
  doctor        Doctor             @relation(fields: [doctorId, clinicId], references: [id, clinicId])
  service       Service            @relation(fields: [serviceId, clinicId], references: [id, clinicId])
  clinicPatient ClinicPatient      @relation(fields: [clinicPatientId, clinicId], references: [id, clinicId])
  events        AppointmentEvent[]
  actionTokens  AppointmentActionToken[]
  notifications NotificationLog[]
  location      Location           @relation(fields: [locationId], references: [id])
  room          Room?              @relation(fields: [roomId], references: [id])
  review        Review?
  payments      Payment[]

  @@index([clinicId, startsAt])
  @@index([doctorId, startsAt])
  @@index([clinicPatientId, startsAt])
}

model AppointmentEvent {
  id            String               @id @default(uuid()) @db.Uuid
  appointmentId String               @db.Uuid
  type          AppointmentEventType
  actorKind     ActorKind
  actorId       String               @db.Uuid
  actorName     String               @db.VarChar(120)
  reason        String?              @db.VarChar(200)
  fromStartsAt  DateTime?            @db.Timestamptz(3)
  toStartsAt    DateTime?            @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
}

// Token de un solo uso enviado por correo (verificación y recuperación de contraseña).
// Sólo se guarda el SHA-256; el token en claro viaja únicamente en el correo.
model AuthToken {
  id               String        @id @default(uuid()) @db.Uuid
  kind             AuthTokenKind
  tokenHash        String        @unique @db.Char(64)
  patientAccountId String?       @db.Uuid
  userId           String?       @db.Uuid
  email            String        @db.VarChar(254)
  expiresAt        DateTime      @db.Timestamptz(3)
  usedAt           DateTime?     @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)

  patientAccount PatientAccount? @relation(fields: [patientAccountId], references: [id])
  user           User?           @relation(fields: [userId], references: [id])

  @@index([patientAccountId])
  @@index([userId])
}

// Invitación al personal: reemplaza la contraseña inicial compartida.
model StaffInvitation {
  id           String    @id @default(uuid()) @db.Uuid
  clinicId     String    @db.Uuid
  email        String    @db.VarChar(254)
  name         String    @db.VarChar(120)
  role         StaffRole
  tokenHash    String    @unique @db.Char(64)
  invitedById  String    @db.Uuid
  expiresAt    DateTime  @db.Timestamptz(3)
  acceptedAt   DateTime? @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  membershipId String?   @db.Uuid
  // Al aceptar, el usuario queda vinculado a este perfil de médico (alta de clínica).
  doctorId     String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
}

// Cola de trabajos persistente. Se inserta en la misma transacción que el cambio
// de negocio, así que un trabajo existe si y sólo si el cambio se confirmó.
model Job {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(60)
  payload     Json
  dedupeKey   String?   @unique @db.VarChar(200)
  runAt       DateTime  @default(now()) @db.Timestamptz(3)
  attempts    Int       @default(0)
  maxAttempts Int       @default(8)
  lockedUntil DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  failedAt    DateTime? @db.Timestamptz(3)
  lastError   String?   @db.VarChar(1000)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
}

// Enlace del recordatorio para confirmar o cancelar sin iniciar sesión.
// Vale para un solo uso, sólo para el horario con que se emitió y vence al iniciar la cita.
model AppointmentActionToken {
  id            String    @id @default(uuid()) @db.Uuid
  appointmentId String    @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  startsAt      DateTime  @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  usedAt        DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
}

// Bitácora de cada envío de recordatorio (canal, resultado y error).
model NotificationLog {
  id            String              @id @default(uuid()) @db.Uuid
  clinicId      String              @db.Uuid
  appointmentId String              @db.Uuid
  channel       NotificationChannel
  kind          String              @db.VarChar(30)
  offsetMinutes Int?
  startsAt      DateTime            @db.Timestamptz(3)
  status        NotificationStatus
  recipient     String?             @db.VarChar(254)
  providerId    String?             @db.VarChar(200)
  error         String?             @db.VarChar(500)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
  @@index([clinicId, createdAt])
}

// Nota interna de la clínica sobre un paciente. No se edita ni se borra (auditoría).
model PatientNote {
  id              String   @id @default(uuid()) @db.Uuid
  clinicId        String   @db.Uuid
  clinicPatientId String   @db.Uuid
  authorId        String   @db.Uuid
  authorName      String   @db.VarChar(120)
  body            String   @db.VarChar(2000)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  clinicPatient ClinicPatient @relation(fields: [clinicPatientId], references: [id])

  @@index([clinicPatientId, createdAt])
}

// Bitácora de cambios a la ficha: edición, vinculación con cuenta en línea y fusiones.
model PatientAudit {
  id              String             @id @default(uuid()) @db.Uuid
  clinicId        String             @db.Uuid
  clinicPatientId String             @db.Uuid
  action          PatientAuditAction
  actorKind       ActorKind
  actorId         String             @db.Uuid
  actorName       String             @db.VarChar(120)
  details         Json
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)

  clinicPatient ClinicPatient @relation(fields: [clinicPatientId], references: [id])

  @@index([clinicPatientId, createdAt])
}

// Solicitud de la clínica para vincular una ficha telefónica con la cuenta en línea del paciente.
// El paciente la confirma con el enlace que llega a su correo.
model PatientLinkRequest {
  id               String    @id @default(uuid()) @db.Uuid
  clinicId         String    @db.Uuid
  clinicPatientId  String    @db.Uuid
  patientAccountId String    @db.Uuid
  tokenHash        String    @unique @db.Char(64)
  requestedById    String    @db.Uuid
  expiresAt        DateTime  @db.Timestamptz(3)
  usedAt           DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  @@index([clinicPatientId])
}

// Lista de espera por médico y servicio, en orden de llegada.
model WaitlistEntry {
  id              String         @id @default(uuid()) @db.Uuid
  clinicId        String         @db.Uuid
  doctorId        String         @db.Uuid
  serviceId       String         @db.Uuid
  clinicPatientId String         @db.Uuid
  // Rango de fechas locales que le sirven al paciente (opcional).
  fromDate        String?        @db.Char(10)
  toDate          String?        @db.Char(10)
  notes           String?        @db.VarChar(300)
  status          WaitlistStatus @default(WAITING)
  appointmentId   String?        @db.Uuid
  createdByKind   ActorKind
  createdById     String         @db.Uuid
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  clinicPatient ClinicPatient   @relation(fields: [clinicPatientId], references: [id])
  offers        WaitlistOffer[]

  @@index([doctorId, status, createdAt])
  @@index([clinicId, status])
}

// Horario liberado que se aparta a una persona de la lista de espera mientras decide.
// Una oferta PENDING vigente bloquea ese horario para cualquier otra reserva.
model WaitlistOffer {
  id            String              @id @default(uuid()) @db.Uuid
  clinicId      String              @db.Uuid
  entryId       String              @db.Uuid
  doctorId      String              @db.Uuid
  startsAt      DateTime            @db.Timestamptz(3)
  endsAt        DateTime            @db.Timestamptz(3)
  expiresAt     DateTime            @db.Timestamptz(3)
  tokenHash     String              @unique @db.Char(64)
  status        WaitlistOfferStatus @default(PENDING)
  appointmentId String?             @db.Uuid
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)

  entry WaitlistEntry @relation(fields: [entryId], references: [id])

  @@index([doctorId, status, startsAt])
}

// Sede de la clínica. Todas las citas y bloques de horario pertenecen a una sede.
model Location {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @db.Uuid
  name      String   @db.VarChar(120)
  address   String?  @db.VarChar(240)
  phone     String?  @db.VarChar(30)
  // Enlace a Google Maps u otro mapa.
  mapUrl    String?  @db.VarChar(500)
  // Zona para el directorio: colonia, ciudad, estado, código postal y coordenadas (búsqueda por radio).
  neighborhood String? @db.VarChar(80)
  city         String? @db.VarChar(80)
  state        String? @db.VarChar(60)
  postalCode   String? @db.VarChar(10)
  latitude     Float?
  longitude    Float?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  hours         LocationHours[]
  rooms         Room[]
  scheduleRules ScheduleRule[]
  appointments  Appointment[]
  prices        ServicePrice[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

// Horario de atención de la sede. Los bloques de los médicos en esa sede deben caber aquí.
model LocationHours {
  id          String @id @default(uuid()) @db.Uuid
  locationId  String @db.Uuid
  weekday     Int
  startMinute Int
  endMinute   Int

  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId])
}

// Consultorio o recurso de una sede: no puede tener dos citas a la vez.
model Room {
  id         String   @id @default(uuid()) @db.Uuid
  clinicId   String   @db.Uuid
  locationId String   @db.Uuid
  name       String   @db.VarChar(60)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  location      Location       @relation(fields: [locationId], references: [id])
  scheduleRules ScheduleRule[]
  appointments  Appointment[]

  @@unique([locationId, name])
}

// Foto del médico (JPEG, PNG o WebP de hasta 900 KB), servida con caché.
model DoctorPhoto {
  doctorId  String   @id @db.Uuid
  mimeType  String   @db.VarChar(20)
  data      Bytes
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  doctor Doctor @relation(fields: [doctorId], references: [id])
}

// Precio especial de un servicio por sede, por médico o por médico en una sede.
// Gana el más específico: médico+sede > médico > sede > precio base del servicio.
model ServicePrice {
  id         String  @id @default(uuid()) @db.Uuid
  clinicId   String  @db.Uuid
  serviceId  String  @db.Uuid
  doctorId   String? @db.Uuid
  locationId String? @db.Uuid
  priceCents Int

  service  Service   @relation(fields: [serviceId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  @@index([serviceId])
}

// Opinión verificada: sólo existe para una cita atendida y hay una por cita.
model Review {
  id                 String       @id @default(uuid()) @db.Uuid
  clinicId           String       @db.Uuid
  doctorId           String       @db.Uuid
  appointmentId      String       @unique @db.Uuid
  clinicPatientId    String       @db.Uuid
  ratingPunctuality  Int
  ratingTreatment    Int
  ratingFacilities   Int
  comment            String?      @db.VarChar(1000)
  // Nombre público: «Ana P.» o «Paciente verificado» si lo pidió anónimo.
  anonymous          Boolean      @default(false)
  authorName         String       @db.VarChar(60)
  status             ReviewStatus @default(PUBLISHED)
  // Moderación vigente (también queda en ReviewEvent).
  hiddenReason       String?      @db.VarChar(30)
  reply              String?      @db.VarChar(1000)
  replyAt            DateTime?    @db.Timestamptz(3)
  replyByName        String?      @db.VarChar(120)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)

  appointment Appointment   @relation(fields: [appointmentId], references: [id])
  events      ReviewEvent[]

  @@index([doctorId, status, createdAt])
  @@index([clinicId, createdAt])
}

// Bitácora de cada cambio a una opinión: nada se borra en silencio.
model ReviewEvent {
  id        String          @id @default(uuid()) @db.Uuid
  reviewId  String          @db.Uuid
  type      ReviewEventType
  actorKind ActorKind
  actorId   String          @db.Uuid
  actorName String          @db.VarChar(120)
  reason    String?         @db.VarChar(30)
  note      String?         @db.VarChar(500)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)

  review Review @relation(fields: [reviewId], references: [id])

  @@index([reviewId, createdAt])
}

// Enlace personal para opinar sobre una cita atendida. Sólo se guarda su SHA-256.
model ReviewInvitation {
  id            String    @id @default(uuid()) @db.Uuid
  appointmentId String    @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  expiresAt     DateTime  @db.Timestamptz(3)
  usedAt        DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([appointmentId])
}

// Alta de una clínica nueva: formulario público con enlace privado que la clínica llena
// (se guarda solo); al enviarlo, un comando lo revisa e importa a Medora.
model ClinicOnboarding {
  id           String           @id @default(uuid()) @db.Uuid
  tokenHash    String           @unique @db.Char(64)
  label        String           @db.VarChar(120)
  contactEmail String?          @db.VarChar(254)
  data         Json             @default("{}")
  status       OnboardingStatus @default(DRAFT)
  expiresAt    DateTime         @db.Timestamptz(3)
  submittedAt  DateTime?        @db.Timestamptz(3)
  importedAt   DateTime?        @db.Timestamptz(3)
  clinicId     String?          @db.Uuid
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  photos OnboardingPhoto[]
}

// Foto de un médico subida durante el alta (se copia a DoctorPhoto al importar).
model OnboardingPhoto {
  onboardingId String   @db.Uuid
  doctorKey    String   @db.VarChar(40)
  mimeType     String   @db.VarChar(20)
  data         Bytes
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  onboarding ClinicOnboarding @relation(fields: [onboardingId], references: [id])

  @@id([onboardingId, doctorKey])
}

// Catálogo normalizado de especialidades (con sinónimos para la búsqueda).
model Specialty {
  id       String   @id @default(uuid()) @db.Uuid
  slug     String   @unique @db.VarChar(80)
  name     String   @db.VarChar(120)
  synonyms String[] @default([])

  doctors    Doctor[]
  conditions ConditionSpecialty[]
}

// Catálogo normalizado de padecimientos, ligados a las especialidades que los atienden.
model Condition {
  id       String   @id @default(uuid()) @db.Uuid
  slug     String   @unique @db.VarChar(80)
  name     String   @db.VarChar(120)
  synonyms String[] @default([])

  specialties ConditionSpecialty[]
  doctors     DoctorCondition[]
}

model ConditionSpecialty {
  conditionId String @db.Uuid
  specialtyId String @db.Uuid

  condition Condition @relation(fields: [conditionId], references: [id])
  specialty Specialty @relation(fields: [specialtyId], references: [id])

  @@id([conditionId, specialtyId])
}

// Padecimientos del catálogo que atiende un médico (deducidos de su lista de padecimientos).
model DoctorCondition {
  doctorId    String @db.Uuid
  conditionId String @db.Uuid

  doctor    Doctor    @relation(fields: [doctorId], references: [id])
  condition Condition @relation(fields: [conditionId], references: [id])

  @@id([doctorId, conditionId])
  @@index([conditionId])
}

// Pago de una cita con Stripe Checkout. Puede haber varios intentos; a lo más uno pagado.
model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  clinicId        String        @db.Uuid
  appointmentId   String        @db.Uuid
  provider        String        @default("stripe") @db.VarChar(20)
  checkoutId      String        @unique @db.VarChar(255)
  checkoutUrl     String?       @db.VarChar(1000)
  paymentIntentId String?       @unique @db.VarChar(255)
  amountCents     Int
  currency        String        @default("mxn") @db.VarChar(3)
  status          PaymentStatus @default(OPEN)
  // card, oxxo o customer_balance (SPEI).
  method          String?       @db.VarChar(30)
  expiresAt       DateTime      @db.Timestamptz(3)
  paidAt          DateTime?     @db.Timestamptz(3)
  refundedCents   Int           @default(0)
  refundReason    String?       @db.VarChar(200)
  refundedAt      DateTime?     @db.Timestamptz(3)
  // Último error del proveedor (p. ej. un reembolso que requiere atención manual).
  lastError       String?       @db.VarChar(500)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
  @@index([clinicId, createdAt])
}

// Eventos de webhook ya procesados: un evento repetido no se vuelve a aplicar.
model PaymentWebhookEvent {
  id         String   @id @db.VarChar(255)
  type       String   @db.VarChar(100)
  receivedAt DateTime @default(now()) @db.Timestamptz(3)
}

// ---------------------------------------------------------------- Expediente clínico (NOM-004-SSA3-2012)
// Nada clínico se borra (disparadores en la base): se conserva más allá de los 5 años que pide la norma.

// Ficha clínica e historia clínica del paciente (secciones de la NOM-004 en `history`).
model ClinicalProfile {
  clinicPatientId String    @id @db.Uuid
  clinicId        String    @db.Uuid
  birthDate       DateTime? @db.Date
  // F, M o X
  sex             String?   @db.VarChar(1)
  curp            String?   @db.VarChar(18)
  bloodType       String?   @db.VarChar(3)
  history         Json      @default("{}")
  updatedById     String?   @db.Uuid
  updatedByName   String?   @db.VarChar(120)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  clinicPatient ClinicPatient @relation(fields: [clinicPatientId], references: [id])
  versions      ClinicalHistoryVersion[]
}

// Cada cambio de la historia clínica queda como versión (quién y cuándo).
model ClinicalHistoryVersion {
  id              String   @id @default(uuid()) @db.Uuid
  clinicPatientId String   @db.Uuid
  snapshot        Json
  authorId        String   @db.Uuid
  authorName      String   @db.VarChar(120)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  profile ClinicalProfile @relation(fields: [clinicPatientId], references: [clinicPatientId])

  @@index([clinicPatientId, createdAt])
}

model Allergy {
  id              String   @id @default(uuid()) @db.Uuid
  clinicId        String   @db.Uuid
  clinicPatientId String   @db.Uuid
  substance       String   @db.VarChar(120)
  reaction        String?  @db.VarChar(200)
  // LEVE, MODERADA o GRAVE
  severity        String   @db.VarChar(10)
  active          Boolean  @default(true)
  recordedById    String   @db.Uuid
  recordedByName  String   @db.VarChar(120)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  clinicPatient ClinicPatient @relation(fields: [clinicPatientId], references: [id])

  @@index([clinicPatientId])
}

// Nota de evolución (SOAP) con signos vitales y diagnósticos CIE-10. Firmada, ya no cambia: se corrige con una adenda.
model ClinicalNote {
  id              String    @id @default(uuid()) @db.Uuid
  clinicId        String    @db.Uuid
  clinicPatientId String    @db.Uuid
  appointmentId   String?   @db.Uuid
  doctorId        String    @db.Uuid
  authorId        String    @db.Uuid
  authorName      String    @db.VarChar(120)
  subjective      String    @default("")
  objective       String    @default("")
  assessment      String    @default("")
  plan            String    @default("")
  vitals          Json      @default("{}")
  diagnoses       Json      @default("[]")
  // Adenda: corrige o complementa una nota firmada.
  amendsId        String?   @db.Uuid
  signedAt        DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  clinicPatient ClinicPatient  @relation(fields: [clinicPatientId], references: [id])
  prescriptions Prescription[]

  @@index([clinicPatientId, createdAt])
  @@index([appointmentId])
}

// Receta: inmutable una vez emitida (sólo se puede anular). El código permite verificarla en línea.
model Prescription {
  id              String    @id @default(uuid()) @db.Uuid
  clinicId        String    @db.Uuid
  clinicPatientId String    @db.Uuid
  noteId          String?   @db.Uuid
  doctorId        String    @db.Uuid
  authorId        String    @db.Uuid
  code            String    @unique @db.VarChar(12)
  items           Json
  instructions    String?   @db.VarChar(2000)
  diagnosis       String?   @db.VarChar(500)
  issuedAt        DateTime  @default(now()) @db.Timestamptz(3)
  voidedAt        DateTime? @db.Timestamptz(3)
  voidReason      String?   @db.VarChar(200)

  clinicPatient ClinicPatient @relation(fields: [clinicPatientId], references: [id])
  note          ClinicalNote? @relation(fields: [noteId], references: [id])

  @@index([clinicPatientId, issuedAt])
}

// Archivo adjunto cifrado (AES-256-GCM) con la llave del servidor.
model ClinicalFile {
  id              String   @id @default(uuid()) @db.Uuid
  clinicId        String   @db.Uuid
  clinicPatientId String   @db.Uuid
  noteId          String?  @db.Uuid
  filename        String   @db.VarChar(200)
  mimeType        String   @db.VarChar(100)
  size            Int
  iv              Bytes
  tag             Bytes
  data            Bytes
  uploadedById    String   @db.Uuid
  uploadedByName  String   @db.VarChar(120)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  clinicPatient ClinicPatient @relation(fields: [clinicPatientId], references: [id])

  @@index([clinicPatientId, createdAt])
}

// Bitácora de acceso al expediente: cada consulta, cambio, impresión e intento denegado.
model ClinicalAccessLog {
  id              String   @id @default(uuid()) @db.Uuid
  clinicId        String   @db.Uuid
  clinicPatientId String   @db.Uuid
  userId          String   @db.Uuid
  userName        String   @db.VarChar(120)
  role            String   @db.VarChar(20)
  action          String   @db.VarChar(40)
  resourceId      String?  @db.Uuid
  ip              String?  @db.VarChar(64)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([clinicPatientId, createdAt])
  @@index([clinicId, createdAt])
}

// Catálogo CIE-10 (códigos de uso frecuente; se admiten otros códigos con formato válido).
model Icd10 {
  code        String @id @db.VarChar(10)
  description String @db.VarChar(255)
}
