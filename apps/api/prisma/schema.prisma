// Medora · Sprint 7
// Todas las entidades de negocio llevan clinicId y se consultan siempre
// filtradas por la clínica obtenida de la sesión.

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  OWNER
  ADMIN
  RECEPTION
  DOCTOR
}

enum SessionKind {
  STAFF
  PATIENT
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE
  STAFF
}

enum ActorKind {
  STAFF
  PATIENT
}

enum AuthTokenKind {
  PATIENT_VERIFY_EMAIL
  PATIENT_RESET_PASSWORD
  STAFF_RESET_PASSWORD
}

enum AppointmentEventType {
  CREATED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
  CONFIRMED
}

enum PatientAuditAction {
  CREATED
  UPDATED
  LINK_REQUESTED
  LINKED
  MERGED
}

enum WaitlistStatus {
  WAITING
  BOOKED
  REMOVED
}

enum WaitlistOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  RELEASED
}

enum VisitType {
  ANY
  FIRST
  FOLLOW_UP
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum ReviewEventType {
  CREATED
  HIDDEN
  RESTORED
  REPLIED
  REPLY_REMOVED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

model Clinic {
  id                      String   @id @default(uuid()) @db.Uuid
  slug                    String   @unique @db.VarChar(60)
  name                    String   @db.VarChar(120)
  timezone                String   @default("America/Mexico_City") @db.VarChar(64)
  phone                   String?  @db.VarChar(30)
  address                 String?  @db.VarChar(240)
  active                  Boolean  @default(true)
  bookingEnabled          Boolean  @default(true)
  minNoticeMinutes        Int      @default(60)
  horizonDays             Int      @default(60)
  patientCancelMinMinutes Int      @default(120)
  remindersEnabled        Boolean  @default(true)
  // Minutos antes de la cita (por defecto 24 h y 2 h).
  reminderOffsets         Int[]    @default([1440, 120])
  whatsappEnabled         Boolean  @default(false)
  // Invitar a opinar a los pacientes después de una cita atendida.
  reviewsEnabled          Boolean  @default(true)
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  memberships    Membership[]
  invitations    StaffInvitation[]
  locations      Location[]
  doctors        Doctor[]
  services       Service[]
  clinicPatients ClinicPatient[]
  appointments   Appointment[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  name         String   @db.VarChar(120)
  passwordHash String   @db.VarChar(255)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  memberships Membership[]
  authTokens  AuthToken[]
}

model Membership {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  clinicId  String    @db.Uuid
  role      StaffRole
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id])
  clinic   Clinic           @relation(fields: [clinicId], references: [id])
  doctor   Doctor?          @relation("DoctorMembership")
  sessions RefreshSession[]

  @@unique([userId, clinicId])
  @@unique([id, clinicId])
  @@index([clinicId])
}

model PatientAccount {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  name         String   @db.VarChar(120)
  phone           String    @db.VarChar(30)
  passwordHash    String    @db.VarChar(255)
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  // Consentimiento expreso para recordatorios por WhatsApp.
  whatsappConsentAt DateTime? @db.Timestamptz(3)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  clinicPatients ClinicPatient[]
  sessions       RefreshSession[]
  authTokens     AuthToken[]
}

model RefreshSession {
  id               String      @id @default(uuid()) @db.Uuid
  kind             SessionKind
  familyId         String      @db.Uuid
  tokenHash        String      @unique @db.Char(64)
  membershipId     String?     @db.Uuid
  patientAccountId String?     @db.Uuid
  expiresAt        DateTime    @db.Timestamptz(3)
  usedAt           DateTime?   @db.Timestamptz(3)
  revokedAt        DateTime?   @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)

  membership     Membership?     @relation(fields: [membershipId], references: [id])
  patientAccount PatientAccount? @relation(fields: [patientAccountId], references: [id])

  @@index([familyId])
  @@index([membershipId])
  @@index([patientAccountId])
}

// Ficha del paciente dentro de una clínica. Puede venir de una cuenta en línea
// o ser capturada por recepción (paciente telefónico sin cuenta).
model ClinicPatient {
  id               String   @id @default(uuid()) @db.Uuid
  clinicId         String   @db.Uuid
  patientAccountId String?  @db.Uuid
  name             String   @db.VarChar(120)
  phone            String   @db.VarChar(30)
  email            String?  @db.VarChar(254)
  // Consentimiento registrado por la clínica (pacientes telefónicos).
  whatsappConsentAt DateTime? @db.Timestamptz(3)
  // Etiquetas libres de la clínica (p. ej. «diabetes», «VIP»).
  tags             String[] @default([])
  // Ficha fusionada en otra: queda oculta y sólo se conserva para auditoría.
  mergedIntoId     String?  @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  patientAccount PatientAccount? @relation(fields: [patientAccountId], references: [id])
  appointments   Appointment[]
  notes          PatientNote[]
  audit          PatientAudit[]
  waitlist       WaitlistEntry[]

  @@unique([clinicId, patientAccountId])
  @@unique([id, clinicId])
  @@index([clinicId, name])
}

model Doctor {
  id           String   @id @default(uuid()) @db.Uuid
  clinicId     String   @db.Uuid
  membershipId String?  @unique @db.Uuid
  displayName  String   @db.VarChar(120)
  // URL pública del médico: /c/<clínica>/<slug>. Estable aunque cambie el nombre.
  slug         String   @db.VarChar(80)
  specialty    String   @db.VarChar(120)
  licenseNumber String? @db.VarChar(30)
  bio          String?  @db.VarChar(1000)
  // Perfil profesional (listas cortas de texto).
  education      String[] @default([])
  certifications String[] @default([])
  languages      String[] @default([])
  conditions     String[] @default([])
  insurers       String[] @default([])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  clinic       Clinic           @relation(fields: [clinicId], references: [id])
  membership   Membership?      @relation("DoctorMembership", fields: [membershipId, clinicId], references: [id, clinicId])
  services     DoctorService[]
  scheduleRules ScheduleRule[]
  timeOffs     TimeOff[]
  appointments Appointment[]
  photo        DoctorPhoto?

  @@unique([id, clinicId])
  @@unique([membershipId, clinicId])
  @@unique([clinicId, slug])
  @@index([clinicId])
}

model Service {
  id              String   @id @default(uuid()) @db.Uuid
  clinicId        String   @db.Uuid
  name            String   @db.VarChar(120)
  durationMinutes Int
  priceCents      Int
  // Primera vez, subsecuente o cualquiera (se exige en reservas en línea).
  visitType       VisitType @default(ANY)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  clinic       Clinic          @relation(fields: [clinicId], references: [id])
  doctors      DoctorService[]
  appointments Appointment[]
  prices       ServicePrice[]

  @@unique([clinicId, name])
  @@unique([id, clinicId])
}

model DoctorService {
  doctorId  String @db.Uuid
  serviceId String @db.Uuid
  clinicId  String @db.Uuid

  doctor  Doctor  @relation(fields: [doctorId, clinicId], references: [id, clinicId])
  service Service @relation(fields: [serviceId, clinicId], references: [id, clinicId])

  @@id([doctorId, serviceId])
}

// Horario semanal en hora local de la clínica. weekday: 1 = lunes … 7 = domingo (ISO).
model ScheduleRule {
  id          String @id @default(uuid()) @db.Uuid
  doctorId    String @db.Uuid
  clinicId    String @db.Uuid
  weekday     Int
  startMinute Int
  endMinute   Int
  locationId  String @db.Uuid
  roomId      String? @db.Uuid

  doctor   Doctor   @relation(fields: [doctorId, clinicId], references: [id, clinicId])
  location Location @relation(fields: [locationId], references: [id])
  room     Room?    @relation(fields: [roomId], references: [id])

  @@index([doctorId])
  @@index([roomId])
}

model TimeOff {
  id          String   @id @default(uuid()) @db.Uuid
  doctorId    String   @db.Uuid
  clinicId    String   @db.Uuid
  startsAt    DateTime @db.Timestamptz(3)
  endsAt      DateTime @db.Timestamptz(3)
  reason      String   @db.VarChar(200)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  doctor Doctor @relation(fields: [doctorId, clinicId], references: [id, clinicId])

  @@index([doctorId, startsAt])
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  clinicId        String            @db.Uuid
  doctorId        String            @db.Uuid
  serviceId       String            @db.Uuid
  clinicPatientId String            @db.Uuid
  startsAt        DateTime          @db.Timestamptz(3)
  endsAt          DateTime          @db.Timestamptz(3)
  status          AppointmentStatus @default(BOOKED)
  source          AppointmentSource
  serviceName     String            @db.VarChar(120)
  durationMinutes Int
  priceCents      Int
  patientNotes    String?           @db.VarChar(500)
  requestKey      String            @unique @db.VarChar(120)
  requestHash     String            @db.Char(64)
  cancelReason    String?           @db.VarChar(200)
  // El paciente confirmó su asistencia (se reinicia al reprogramar).
  confirmedAt     DateTime?         @db.Timestamptz(3)
  // Cita subsecuente: la cita atendida de la que se agendó.
  followUpOfId    String?           @db.Uuid
  // Canal por el que llegó una reserva en línea: web, widget, google o instagram.
  channel         String?           @db.VarChar(20)
  // Sede y consultorio del bloque del horario en que cae la cita.
  locationId      String            @db.Uuid
  roomId          String?           @db.Uuid
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  clinic        Clinic             @relation(fields: [clinicId], references: [id])
  doctor        Doctor             @relation(fields: [doctorId, clinicId], references: [id, clinicId])
  service       Service            @relation(fields: [serviceId, clinicId], references: [id, clinicId])
  clinicPatient ClinicPatient      @relation(fields: [clinicPatientId, clinicId], references: [id, clinicId])
  events        AppointmentEvent[]
  actionTokens  AppointmentActionToken[]
  notifications NotificationLog[]
  location      Location           @relation(fields: [locationId], references: [id])
  room          Room?              @relation(fields: [roomId], references: [id])
  review        Review?

  @@index([clinicId, startsAt])
  @@index([doctorId, startsAt])
  @@index([clinicPatientId, startsAt])
}

model AppointmentEvent {
  id            String               @id @default(uuid()) @db.Uuid
  appointmentId String               @db.Uuid
  type          AppointmentEventType
  actorKind     ActorKind
  actorId       String               @db.Uuid
  actorName     String               @db.VarChar(120)
  reason        String?              @db.VarChar(200)
  fromStartsAt  DateTime?            @db.Timestamptz(3)
  toStartsAt    DateTime?            @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
}

// Token de un solo uso enviado por correo (verificación y recuperación de contraseña).
// Sólo se guarda el SHA-256; el token en claro viaja únicamente en el correo.
model AuthToken {
  id               String        @id @default(uuid()) @db.Uuid
  kind             AuthTokenKind
  tokenHash        String        @unique @db.Char(64)
  patientAccountId String?       @db.Uuid
  userId           String?       @db.Uuid
  email            String        @db.VarChar(254)
  expiresAt        DateTime      @db.Timestamptz(3)
  usedAt           DateTime?     @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)

  patientAccount PatientAccount? @relation(fields: [patientAccountId], references: [id])
  user           User?           @relation(fields: [userId], references: [id])

  @@index([patientAccountId])
  @@index([userId])
}

// Invitación al personal: reemplaza la contraseña inicial compartida.
model StaffInvitation {
  id           String    @id @default(uuid()) @db.Uuid
  clinicId     String    @db.Uuid
  email        String    @db.VarChar(254)
  name         String    @db.VarChar(120)
  role         StaffRole
  tokenHash    String    @unique @db.Char(64)
  invitedById  String    @db.Uuid
  expiresAt    DateTime  @db.Timestamptz(3)
  acceptedAt   DateTime? @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  membershipId String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
}

// Cola de trabajos persistente. Se inserta en la misma transacción que el cambio
// de negocio, así que un trabajo existe si y sólo si el cambio se confirmó.
model Job {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(60)
  payload     Json
  dedupeKey   String?   @unique @db.VarChar(200)
  runAt       DateTime  @default(now()) @db.Timestamptz(3)
  attempts    Int       @default(0)
  maxAttempts Int       @default(8)
  lockedUntil DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  failedAt    DateTime? @db.Timestamptz(3)
  lastError   String?   @db.VarChar(1000)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
}

// Enlace del recordatorio para confirmar o cancelar sin iniciar sesión.
// Vale para un solo uso, sólo para el horario con que se emitió y vence al iniciar la cita.
model AppointmentActionToken {
  id            String    @id @default(uuid()) @db.Uuid
  appointmentId String    @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  startsAt      DateTime  @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  usedAt        DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
}

// Bitácora de cada envío de recordatorio (canal, resultado y error).
model NotificationLog {
  id            String              @id @default(uuid()) @db.Uuid
  clinicId      String              @db.Uuid
  appointmentId String              @db.Uuid
  channel       NotificationChannel
  kind          String              @db.VarChar(30)
  offsetMinutes Int?
  startsAt      DateTime            @db.Timestamptz(3)
  status        NotificationStatus
  recipient     String?             @db.VarChar(254)
  providerId    String?             @db.VarChar(200)
  error         String?             @db.VarChar(500)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
  @@index([clinicId, createdAt])
}

// Nota interna de la clínica sobre un paciente. No se edita ni se borra (auditoría).
model PatientNote {
  id              String   @id @default(uuid()) @db.Uuid
  clinicId        String   @db.Uuid
  clinicPatientId String   @db.Uuid
  authorId        String   @db.Uuid
  authorName      String   @db.VarChar(120)
  body            String   @db.VarChar(2000)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  clinicPatient ClinicPatient @relation(fields: [clinicPatientId], references: [id])

  @@index([clinicPatientId, createdAt])
}

// Bitácora de cambios a la ficha: edición, vinculación con cuenta en línea y fusiones.
model PatientAudit {
  id              String             @id @default(uuid()) @db.Uuid
  clinicId        String             @db.Uuid
  clinicPatientId String             @db.Uuid
  action          PatientAuditAction
  actorKind       ActorKind
  actorId         String             @db.Uuid
  actorName       String             @db.VarChar(120)
  details         Json
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)

  clinicPatient ClinicPatient @relation(fields: [clinicPatientId], references: [id])

  @@index([clinicPatientId, createdAt])
}

// Solicitud de la clínica para vincular una ficha telefónica con la cuenta en línea del paciente.
// El paciente la confirma con el enlace que llega a su correo.
model PatientLinkRequest {
  id               String    @id @default(uuid()) @db.Uuid
  clinicId         String    @db.Uuid
  clinicPatientId  String    @db.Uuid
  patientAccountId String    @db.Uuid
  tokenHash        String    @unique @db.Char(64)
  requestedById    String    @db.Uuid
  expiresAt        DateTime  @db.Timestamptz(3)
  usedAt           DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  @@index([clinicPatientId])
}

// Lista de espera por médico y servicio, en orden de llegada.
model WaitlistEntry {
  id              String         @id @default(uuid()) @db.Uuid
  clinicId        String         @db.Uuid
  doctorId        String         @db.Uuid
  serviceId       String         @db.Uuid
  clinicPatientId String         @db.Uuid
  // Rango de fechas locales que le sirven al paciente (opcional).
  fromDate        String?        @db.Char(10)
  toDate          String?        @db.Char(10)
  notes           String?        @db.VarChar(300)
  status          WaitlistStatus @default(WAITING)
  appointmentId   String?        @db.Uuid
  createdByKind   ActorKind
  createdById     String         @db.Uuid
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  clinicPatient ClinicPatient   @relation(fields: [clinicPatientId], references: [id])
  offers        WaitlistOffer[]

  @@index([doctorId, status, createdAt])
  @@index([clinicId, status])
}

// Horario liberado que se aparta a una persona de la lista de espera mientras decide.
// Una oferta PENDING vigente bloquea ese horario para cualquier otra reserva.
model WaitlistOffer {
  id            String              @id @default(uuid()) @db.Uuid
  clinicId      String              @db.Uuid
  entryId       String              @db.Uuid
  doctorId      String              @db.Uuid
  startsAt      DateTime            @db.Timestamptz(3)
  endsAt        DateTime            @db.Timestamptz(3)
  expiresAt     DateTime            @db.Timestamptz(3)
  tokenHash     String              @unique @db.Char(64)
  status        WaitlistOfferStatus @default(PENDING)
  appointmentId String?             @db.Uuid
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)

  entry WaitlistEntry @relation(fields: [entryId], references: [id])

  @@index([doctorId, status, startsAt])
}

// Sede de la clínica. Todas las citas y bloques de horario pertenecen a una sede.
model Location {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @db.Uuid
  name      String   @db.VarChar(120)
  address   String?  @db.VarChar(240)
  phone     String?  @db.VarChar(30)
  // Enlace a Google Maps u otro mapa.
  mapUrl    String?  @db.VarChar(500)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  hours         LocationHours[]
  rooms         Room[]
  scheduleRules ScheduleRule[]
  appointments  Appointment[]
  prices        ServicePrice[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

// Horario de atención de la sede. Los bloques de los médicos en esa sede deben caber aquí.
model LocationHours {
  id          String @id @default(uuid()) @db.Uuid
  locationId  String @db.Uuid
  weekday     Int
  startMinute Int
  endMinute   Int

  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId])
}

// Consultorio o recurso de una sede: no puede tener dos citas a la vez.
model Room {
  id         String   @id @default(uuid()) @db.Uuid
  clinicId   String   @db.Uuid
  locationId String   @db.Uuid
  name       String   @db.VarChar(60)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  location      Location       @relation(fields: [locationId], references: [id])
  scheduleRules ScheduleRule[]
  appointments  Appointment[]

  @@unique([locationId, name])
}

// Foto del médico (JPEG, PNG o WebP de hasta 900 KB), servida con caché.
model DoctorPhoto {
  doctorId  String   @id @db.Uuid
  mimeType  String   @db.VarChar(20)
  data      Bytes
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  doctor Doctor @relation(fields: [doctorId], references: [id])
}

// Precio especial de un servicio por sede, por médico o por médico en una sede.
// Gana el más específico: médico+sede > médico > sede > precio base del servicio.
model ServicePrice {
  id         String  @id @default(uuid()) @db.Uuid
  clinicId   String  @db.Uuid
  serviceId  String  @db.Uuid
  doctorId   String? @db.Uuid
  locationId String? @db.Uuid
  priceCents Int

  service  Service   @relation(fields: [serviceId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  @@index([serviceId])
}

// Opinión verificada: sólo existe para una cita atendida y hay una por cita.
model Review {
  id                 String       @id @default(uuid()) @db.Uuid
  clinicId           String       @db.Uuid
  doctorId           String       @db.Uuid
  appointmentId      String       @unique @db.Uuid
  clinicPatientId    String       @db.Uuid
  ratingPunctuality  Int
  ratingTreatment    Int
  ratingFacilities   Int
  comment            String?      @db.VarChar(1000)
  // Nombre público: «Ana P.» o «Paciente verificado» si lo pidió anónimo.
  anonymous          Boolean      @default(false)
  authorName         String       @db.VarChar(60)
  status             ReviewStatus @default(PUBLISHED)
  // Moderación vigente (también queda en ReviewEvent).
  hiddenReason       String?      @db.VarChar(30)
  reply              String?      @db.VarChar(1000)
  replyAt            DateTime?    @db.Timestamptz(3)
  replyByName        String?      @db.VarChar(120)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)

  appointment Appointment   @relation(fields: [appointmentId], references: [id])
  events      ReviewEvent[]

  @@index([doctorId, status, createdAt])
  @@index([clinicId, createdAt])
}

// Bitácora de cada cambio a una opinión: nada se borra en silencio.
model ReviewEvent {
  id        String          @id @default(uuid()) @db.Uuid
  reviewId  String          @db.Uuid
  type      ReviewEventType
  actorKind ActorKind
  actorId   String          @db.Uuid
  actorName String          @db.VarChar(120)
  reason    String?         @db.VarChar(30)
  note      String?         @db.VarChar(500)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)

  review Review @relation(fields: [reviewId], references: [id])

  @@index([reviewId, createdAt])
}

// Enlace personal para opinar sobre una cita atendida. Sólo se guarda su SHA-256.
model ReviewInvitation {
  id            String    @id @default(uuid()) @db.Uuid
  appointmentId String    @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  expiresAt     DateTime  @db.Timestamptz(3)
  usedAt        DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([appointmentId])
}
