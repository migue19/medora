# Desarrollo sin Docker: PostgreSQL 17 local
DATABASE_URL=postgresql://medora:medora@127.0.0.1:5432/medora
JWT_SECRET=
WEB_ORIGIN=http://localhost:6011
COOKIE_SECURE=false
# Sin SMTP_HOST los correos (verificación, recuperación, invitaciones, citas) se escriben en la bitácora.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Medora <no-reply@localhost>
PORT=6010
HOST=127.0.0.1
SEED_CLINIC_SLUG=mi-clinica
SEED_CLINIC_NAME=Mi Clínica
SEED_OWNER_EMAIL=
SEED_OWNER_NAME=
SEED_OWNER_PASSWORD=
SEED_DEMO_DATA=true
