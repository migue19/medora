{
  "name": "@medora/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch-path=dist --env-file-if-exists=.env dist/main.js)",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rm -rf dist-test && tsc -p tsconfig.json --outDir dist-test && node --test \"dist-test/test/unit/**/*.test.js\"",
    "test:integration": "rm -rf dist-test && tsc -p tsconfig.json --outDir dist-test && node --test --test-concurrency=1 \"dist-test/test/integration/**/*.test.js\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "luxon": "3.7.2",
    "nodemailer": "10.0.13",
    "pdfkit": "0.20.2",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "22.6.2",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
}
